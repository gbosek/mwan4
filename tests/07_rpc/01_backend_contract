-- Testcase --
import m from 'mwan4';

m.set_scriptname('test');
m.init();

let calls = [];
global.system = function(command) {
	push(calls, command);
	return 0;
};

let bad_action = m.control({ action: 'shell', command: 'reboot' });
print('bad action ok: ' + bad_action.ok + '\n');
print('bad action code: ' + bad_action.errors[0].code + '\n');

let missing_iface = m.control({ action: 'ifdown', interface: 'not_there' });
print('missing iface ok: ' + missing_iface.ok + '\n');
print('missing iface code: ' + missing_iface.errors[0].code + '\n');

let ifdown = m.control({ action: 'ifdown', interface: 'wan' });
print('ifdown ok: ' + ifdown.ok + '\n');

let reset = m.control({ action: 'reset_counters' });
print('reset counters ok: ' + reset.ok + '\n');
let runtime_install = m.control({ action: 'install_feature', feature: 'pbr' });
print('runtime install ok: ' + runtime_install.ok + '\n');
print('runtime install code: ' + runtime_install.errors[0].code + '\n');
let advanced_restart = m.advanced_control({ action: 'restart' });
print('advanced restart ok: ' + advanced_restart.ok + '\n');
print('advanced restart code: ' + advanced_restart.errors[0].code + '\n');
let install = m.advanced_control({ action: 'install_feature', feature: 'pbr' });
print('install feature ok: ' + install.ok + '\n');
print('install feature packages: ' + join(',', install.packages) + '\n');
let bfd = m.advanced_control({ action: 'apply_bfd' });
print('bfd apply ok: ' + bfd.ok + '\n');
print('calls: ' + join('|', calls) + '\n');
-- End --

