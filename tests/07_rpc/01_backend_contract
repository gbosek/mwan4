let rpcd = require('rpcd_mwan4');
let methods = rpcd.mwan4;

for (let method in ['status', 'capabilities', 'validate', 'diagnostics', 'control', 'advanced_control', 'pbr_import'])
	print(method + ': ' + (exists(methods, method) ? 'yes' : 'no') + '\n');

let caps = methods.capabilities.call({ args: {} });
print('cap version: ' + caps.version + '\n');
print('cap status sections: ' + join(',', caps.status.sections) + '\n');
print('cap diagnostic sections: ' + join(',', caps.diagnostics.sections) + '\n');
print('cap probe methods: ' + join(',', caps.probes.track_methods) + '\n');
print('cap control actions: ' + join(',', caps.control.actions) + '\n');
print('cap advanced actions: ' + join(',', caps.advanced_control.actions) + '\n');
print('cap package pbr: ' + join(',', caps.packages.features.pbr) + '\n');

let rpc_advanced_restart = methods.advanced_control.call({ args: { action: 'restart' } });
print('rpc advanced restart ok: ' + rpc_advanced_restart.ok + '\n');
print('rpc advanced restart code: ' + rpc_advanced_restart.errors[0].code + '\n');

let validation = methods.validate.call({ args: {} });
print('validate valid: ' + validation.valid + '\n');
print('validate errors: ' + length(validation.errors) + '\n');
print('validate interface count: ' + validation.counts.interfaces + '\n');
print('validate route count: ' + validation.counts.routes + '\n');

let diagnostics = methods.diagnostics.call({ args: { section: 'summary' } });
let summary = diagnostics.diagnostics.summary;
print('diag mask: ' + summary.mmx_mask + '\n');
print('diag interfaces: ' + join(',', summary.interfaces) + '\n');
print('diag enabled: ' + join(',', summary.enabled_interfaces) + '\n');
print('diag next steps: ' + length(summary.status.next_steps) + '\n');
print('diag first step: ' + summary.status.next_steps[0].id + '\n');
