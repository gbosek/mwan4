-- Testcase --
import m from 'mwan4';

m.set_scriptname('test');
m.init();
m.update_iface_to_table();

// Match init_setup.uc ordering: interface setup precedes tracker-state seeding.
m.ifup('wan', 'init');
print('state after ifup: ' + m.get_iface_hotplug_state('wan') + '\n');

m.init_iface_hotplug_states();
m.nft_file('create', 'dynamic');
m.set_strategies_nftables();
m.nft_file('install', 'dynamic');

let dynamic = global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/10-mwan4.nft');
print('unvalidated wan selected: ' + (index(dynamic, 'meta mark set 0x100 comment "wan 1 1"') >= 0) + '\n');

global.mocklib.capture('/var/run/mwan4track/wan_ipv4/STATUS', 'online\n');
m.init_iface_hotplug_states();
m.nft_file('create', 'dynamic');
m.set_strategies_nftables();
m.nft_file('install', 'dynamic');

dynamic = global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/10-mwan4.nft');
print('state after validation: ' + m.get_iface_hotplug_state('wan') + '\n');
print('validated wan selected: ' + (index(dynamic, 'meta mark set 0x100 comment "wan 1 1"') >= 0) + '\n');
-- End --

