Native startup installs actual UCI-assigned WAN IDs without spawning nested hotplug.

-- Testcase --
import m from 'mwan4';
m.init();
let calls = [];
global.system = function(command) { push(calls, command); return 0; };
m.ifup('wanb', 'init');
for (let command in calls)
	if (index(command, 'rule add pref') >= 0 || index(command, 'env -i') >= 0)
		print(command, '\n');
print(global.mocklib.read_captured('/var/run/mwan4/iface_state/wanb'), '\n');
-- End --

